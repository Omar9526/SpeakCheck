# Скопируйте в backend/.env и заполните. Файл .env в git не попадает.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://speakcheck:speakcheck@localhost:5432/speakcheck
REDIS_URL=redis://localhost:6379/0

# Sign in with Apple (проверка identity token на сервере)
APPLE_BUNDLE_ID=kg.speakcheck.app

# Azure AI Speech — Pronunciation Assessment
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# DeepSeek — объяснения ошибок
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Лимиты
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=90
DAILY_ATTEMPTS_PER_USER=200

# Продакшн
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=31536000

# Ссылки-вызовы
PUBLIC_BASE_URL=https://speakcheck.example.com
APP_STORE_URL=https://apps.apple.com/
