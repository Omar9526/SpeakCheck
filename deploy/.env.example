# Скопируйте в deploy/.env на сервере и заполните. В git не попадает.

# Домен, направленный A-записью на IP сервера (например api.speakcheck.kg)
DOMAIN=
# Длинные случайные строки: openssl rand -hex 32
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Azure AI Speech — Pronunciation Assessment
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Голос для «Послушать» (Azure Text to Speech). Ещё живее — HD: en-US-Ava:DragonHDLatestNeural (не во всех регионах)
AZURE_TTS_VOICE=en-US-AvaMultilingualNeural

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Apple: Team ID из developer.apple.com → Membership (для Universal Links)
APPLE_BUNDLE_ID=kg.speakcheck.app
APPLE_TEAM_ID=

APP_STORE_URL=https://apps.apple.com/
SUPPORT_EMAIL=
SECURE_HSTS_SECONDS=31536000
